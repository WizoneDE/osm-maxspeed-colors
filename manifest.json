{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.5.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "__MSG_extActionTitle__"
  },
  "content_scripts": [
    {
      "matches": ["https://www.openstreetmap.org/*", "https://openstreetmap.org/*"],
      "js": ["settings.js", "bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.openstreetmap.org/*", "https://openstreetmap.org/*"],
      "js": ["generated/signs.js", "generated/default-speeds.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
